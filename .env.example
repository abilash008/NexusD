# NexusD Environment Template (Copy to .env.local)

# 1. Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-1234.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Auth.js / NextAuth v5
AUTH_SECRET="your-32-character-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# 3. Google OAuth 2.0 Credentials
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# 4. Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
